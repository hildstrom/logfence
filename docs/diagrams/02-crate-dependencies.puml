@startuml crate-dependencies
title logfence — Crate Dependency Structure

skinparam defaultFontName Monospaced
skinparam packageStyle rectangle
skinparam ArrowColor #444444
skinparam BackgroundColor #FAFAFA

package "logfence workspace" {

  package "logfence-proto" <<crate>> #DDEEFF {
    [Facility / Severity / Priority]
    [SyslogMessage\n(parser + Display)]
    [OctetCountCodec\n(RFC 6587 §3.4.1)]
    [DelimiterCodec\n(RFC 6587 §3.4.2)]
    [ParseError / FrameError]
  }

  package "logfence-client" <<crate>> #DDFFD0 {
    [MessageBuilder\n(fluent API)]
    [UnixTransport\n(stream socket)]
    [UnixDatagramTransport\n(datagram socket)]
    [Transport trait\n(async send)]
    [CEE_COOKIE constant]
    [now_rfc3339()]
  }

  package "logfence-daemon" <<crate>> #FFEECC {
    [config.rs]
    [validator.rs]
    [forwarder.rs]
    [session.rs]
    [listener.rs]
    [datagram_listener.rs]
    [metrics.rs]
    [main.rs]
  }

  package "logfence-itests" <<crate>> #F0F0F0 {
    [integration tests]
    [benchmarks]
  }

}

[logfence-client] --> [logfence-proto] : uses SyslogMessage,\nOctetCountCodec
[logfence-daemon] --> [logfence-proto] : uses SyslogMessage,\nOctetCountCodec,\nDelimiterCodec
[logfence-itests] --> [logfence-client] : MessageBuilder,\nUnixTransport
[logfence-itests] --> [logfence-proto] : Facility, Severity

note right of [logfence-proto]
  No external runtime deps.
  tokio-util codec traits only.
end note

note right of [logfence-client]
  No chrono dependency.
  Uses std::time for timestamps.
end note

note right of [logfence-daemon]
  tokio, serde, jsonschema,
  clap, tracing, tokio-util
end note

@enduml
